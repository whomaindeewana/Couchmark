{
  // ── API Keys ──────────────────────────────────────────────────────────────
  // Enter your keys in the Settings screen on first launch.
  // For development, copy this file to appsettings.local.json and fill in your keys.
  // appsettings.local.json is git-ignored and will never be committed.
  "ApiKeys": {
    "Tmdb": "",
    "Omdb": ""
  },

  // ── Library Paths ─────────────────────────────────────────────────────────
  // Folders the scanner will monitor for video files.
  // Add paths via the Settings screen — they are saved here automatically.
  "Libraries": {
    "MoviePaths": [],
    "TvShowPaths": []
  },

  // ── Appearance ────────────────────────────────────────────────────────────
  "Appearance": {
    "Theme": "Dark",
    "AccentColor": "#0078D4"
  },

  // ── Playback ──────────────────────────────────────────────────────────────
  // These mirror AppConstants defaults but can be overridden here by the user.
  "Playback": {
    "ResumeThresholdSeconds": 30,
    "CompletedThresholdPercent": 90,
    "SaveProgressIntervalSeconds": 5,
    "AutoPlayCountdownSeconds": 10
  },

  // ── Logging ───────────────────────────────────────────────────────────────
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "File", "Args": { "path": "logs/couchmark-.log", "rollingInterval": "Day" } }
    ]
  }
}

<Page x:Class="Couchmark.Views.LibraryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:extensions="clr-namespace:Couchmark.Extensions">
    <!--
        LibraryView: TV Shows library grid with live search, sorting,
        and right-click context menu actions.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  extensions:ScrollViewerExtensions.EnableMouseWheelScroll="True">
        <Grid Margin="28,24,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Top Toolbar: Title, Search & Sort ───────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="TV Shows" 
                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                           FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />

                <!-- Live Search Box -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxWidth="340" Height="36"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Padding="12,6"
                         FontSize="14"
                         Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                         Background="{DynamicResource CouchmarkCardBrush}"
                         BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                         BorderThickness="1" />

                <!-- Sort Label -->
                <TextBlock Grid.Column="2" Text="Sort:" 
                           Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,8,0" />

                <!-- Sort Options ComboBox -->
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding AvailableSortOptions}"
                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                          Width="180" Height="36"
                          VerticalAlignment="Center" />
            </Grid>

            <!-- ── TV Show Poster Cards Grid ───────────────────────────────────── -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding TvShows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction Margin="0,0,18,18" Padding="0" Width="200" Height="300" Cursor="Hand"
                                       IsChevronVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                       Command="{Binding DataContext.NavigateToDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding Id}"
                                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                            <!-- Right-Click Context Menu -->
                            <ui:CardAction.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="View Details"
                                              Command="{Binding PlacementTarget.Tag.NavigateToDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Id}" />
                                    <MenuItem Header="Toggle Watched All"
                                              Command="{Binding PlacementTarget.Tag.ToggleWatchedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Open Folder Location"
                                              Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </ui:CardAction.ContextMenu>

                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,200,300" RadiusX="8" RadiusY="8" />
                                </Grid.Clip>
                                <!-- Poster Image -->
                                <Image Source="{Binding LocalPosterPath}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                
                                <!-- Overlay title at bottom -->
                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold" 
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FirstAirYear, StringFormat={}{0}}" 
                                                   Foreground="#AAAAAA" 
                                                   FontSize="12" 
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>

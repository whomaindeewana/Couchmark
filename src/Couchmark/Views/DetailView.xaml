<Page x:Class="Couchmark.Views.DetailView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:extensions="clr-namespace:Couchmark.Extensions">
    <!--
        DetailView: Displays poster, backdrop, full metadata, ratings, overview,
        season/episode list for TV Shows, and movie action panel / backdrop for Movies.
    -->
    <Grid>
        <!-- ── Content Area: Two Column Layout ──────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left Pane: Poster & Info (35% width) -->
                <ColumnDefinition Width="35*" MaxWidth="400" />
                <!-- Right Pane: Seasons & Episodes OR Movie Actions (65% width) -->
                <ColumnDefinition Width="65*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left Pane ───────────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="32,32,16,32"
                          extensions:ScrollViewerExtensions.EnableMouseWheelScroll="True">
                <StackPanel>
                    <!-- Poster -->
                    <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,0,24"
                            Background="{DynamicResource CouchmarkCardBrush}"
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" BorderThickness="1">
                        <Image Source="{Binding PosterPath}" Stretch="UniformToFill" />
                    </Border>

                    <!-- Title & Meta -->
                    <TextBlock Text="{Binding Title}" 
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                               FontSize="32" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <!-- Ratings -->
                        <ui:SymbolIcon Symbol="Star24" Foreground="#FFD700" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding RatingText}" 
                                   Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                   FontWeight="SemiBold" Margin="0,0,12,0" />
                        <!-- Release Year -->
                        <TextBlock Text="{Binding YearText}" 
                                   Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                   Margin="0,0,12,0" />
                        <!-- Movie Runtime -->
                        <TextBlock Text="{Binding RuntimeText}" 
                                   Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                   Visibility="{Binding IsMovie, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,0,12,0" />
                        <!-- Genres -->
                        <TextBlock Text="{Binding GenresText}" 
                                   Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </StackPanel>

                    <!-- Fix Match & Skip Timestamps Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:Button Content="Fix Match..." 
                                   Icon="{ui:SymbolIcon Symbol=Search24}" 
                                   Appearance="Secondary" 
                                   Command="{Binding OpenFixMatchCommand}"
                                   Cursor="Hand"
                                   Padding="14,8"
                                   Margin="0,0,8,0" />

                        <ui:Button Content="Skip Timestamps..." 
                                   Icon="{ui:SymbolIcon Symbol=Timer24}" 
                                   Appearance="Secondary" 
                                   Command="{Binding OpenMovieTimestampsCommand}"
                                   Visibility="{Binding IsMovie, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Cursor="Hand"
                                   Padding="14,8" />
                    </StackPanel>

                    <!-- Overview -->
                    <TextBlock Text="{Binding Overview}" 
                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                               TextWrapping="Wrap" 
                               FontSize="14" 
                               LineHeight="22" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── Right Pane: TV Shows (Seasons & Episodes) ──────────────────── -->
            <Grid Grid.Column="1" Margin="16,32,32,32"
                  Visibility="{Binding IsMovie, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                  extensions:ScrollViewerExtensions.EnableMouseWheelScroll="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Season Selector with Ghost Season Support -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Seasons" 
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding AvailableSeasons}" 
                             SelectedItem="{Binding SelectedSeason, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CouchmarkCardBrush}" 
                                        BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" Padding="12,6" Margin="0,0,8,8"
                                        Opacity="{Binding Opacity}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" 
                                                   Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <!-- Watched Badge for Season -->
                                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#4CAF50" FontSize="14" Margin="6,0,0,0"
                                                       Visibility="{Binding IsWatched, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <!-- Ghost Season Indicator -->
                                        <TextBlock Text=" (Missing)" 
                                                   Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                                   FontSize="12" Margin="4,0,0,0"
                                                   Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Episode List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              extensions:ScrollViewerExtensions.EnableMouseWheelScroll="True">
                    <ItemsControl ItemsSource="{Binding Episodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardAction Margin="0,0,0,12" Padding="12"
                                               Background="{DynamicResource CouchmarkCardBrush}"
                                               BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                                               BorderThickness="1"
                                               IsEnabled="{Binding FileAvailable}"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <!-- Right-Click Context Menu -->
                                    <ui:CardAction.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Play Episode"
                                                      Command="{Binding PlacementTarget.Tag.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Id}" />
                                            <MenuItem Header="Toggle Watched"
                                                      Command="{Binding PlacementTarget.Tag.ToggleEpisodeWatchedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Edit Skip Timestamps..."
                                                      Command="{Binding PlacementTarget.Tag.OpenEpisodeTimestampsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Open File Location"
                                                      Command="{Binding PlacementTarget.Tag.OpenEpisodeFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </ui:CardAction.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail Placeholder with Watched & Progress -->
                                        <Grid Grid.Column="0" Width="160" Height="90" Margin="0,0,16,0">
                                            <Border CornerRadius="4" 
                                                    Background="{DynamicResource CouchmarkBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                                                    BorderThickness="1"
                                                    ClipToBounds="True">
                                                <!-- Still image (shown when StillPath is not null) -->
                                                <Grid>
                                                    <Image Source="{Binding StillPath}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <!-- Fallback icon (shown when StillPath is null/empty) -->
                                                    <ui:SymbolIcon Symbol="Video24" Opacity="0.3" FontSize="32" 
                                                                   Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                                                   Visibility="{Binding StillPath, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>

                                            <!-- Watched Badge -->
                                            <Border Background="#CC000000" CornerRadius="12" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                    Visibility="{Binding WatchProgress.IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ui:SymbolIcon Symbol="Checkmark24" Foreground="#4CAF50" FontSize="14" />
                                            </Border>

                                            <!-- Progress Bar -->
                                            <ProgressBar VerticalAlignment="Bottom" Height="4" BorderThickness="0"
                                                         Value="{Binding WatchProgress.PositionSeconds, TargetNullValue=0}"
                                                         Maximum="{Binding WatchProgress.DurationSeconds, TargetNullValue=1}" />
                                        </Grid>

                                        <!-- Episode Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding SeasonNumber, StringFormat={}S{0:D2}}" 
                                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                                           FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding EpisodeNumber, StringFormat={}E{0:D2}}" 
                                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                                           FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Title}" 
                                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                                           FontSize="16" FontWeight="Medium" />
                                                <!-- Unavailable Badge -->
                                                <TextBlock Text="(File Missing)" Foreground="#E57373" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding FileAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Overview}" 
                                                       Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                                       TextWrapping="Wrap" 
                                                       MaxHeight="40" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       FontSize="13" />
                                        </StackPanel>

                                        <!-- Play Button -->
                                        <ui:Button Grid.Column="2" 
                                                   Icon="{ui:SymbolIcon Symbol=Play24}" 
                                                   Appearance="Primary" 
                                                   VerticalAlignment="Center" 
                                                   Padding="16,12"
                                                   IsEnabled="{Binding FileAvailable}"
                                                   Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding Id}" />
                                    </Grid>
                                </ui:CardAction>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── Right Pane: Movie Detail (Backdrop, Actions, Metadata) ──────── -->
            <ScrollViewer Grid.Column="1" Margin="16,32,32,32"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsMovie, Converter={StaticResource BoolToVisibilityConverter}}"
                          extensions:ScrollViewerExtensions.EnableMouseWheelScroll="True">
                <StackPanel>
                    <!-- Backdrop Banner Card -->
                    <Border CornerRadius="12" Height="340" ClipToBounds="True" 
                            Background="{DynamicResource CouchmarkCardBrush}"
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                            BorderThickness="1" 
                            Margin="0,0,0,24">
                        <Grid>
                            <Image Source="{Binding BackdropPath}" Stretch="UniformToFill" />

                            <!-- Bottom Gradient Overlay -->
                            <Border VerticalAlignment="Bottom" Height="150">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#E6000000" Offset="0.8" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <!-- Action Buttons on Backdrop -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="24,0,24,20">
                                    <!-- Primary Play / Resume Button -->
                                    <ui:Button Content="{Binding ResumeButtonText}" 
                                               Command="{Binding PlayMovieCommand}"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Symbol=Play24}"
                                               Padding="22,12" FontSize="15" FontWeight="Bold"
                                               Margin="0,0,12,0" />

                                    <!-- Restart Button -->
                                    <ui:Button Content="Restart"
                                               Command="{Binding RestartMovieCommand}"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Symbol=ArrowCounterclockwise24}"
                                               Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Padding="16,12" FontSize="14"
                                               Margin="0,0,12,0" />

                                    <!-- Mark Watched / Unwatched Toggle -->
                                    <ui:Button Content="{Binding WatchedButtonText}"
                                               Command="{Binding ToggleWatchedCommand}"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Symbol=Checkmark24}"
                                               Padding="16,12" FontSize="14"
                                               Margin="0,0,12,0" />

                                    <!-- Open Location -->
                                    <ui:Button Content="Open Folder"
                                               Command="{Binding OpenFileLocationCommand}"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                               Padding="16,12" FontSize="14" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Movie File Information Card -->
                    <Border Background="{DynamicResource CouchmarkCardBrush}" 
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="24">
                        <StackPanel>
                            <TextBlock Text="File &amp; Playback Details" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="File Path:" Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Movie.FilePath}" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Runtime:" Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding RuntimeText}" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Release Year:" Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding YearText}" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Watch Status:" Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" Foreground="#4CAF50" FontSize="14" Margin="0,0,6,0"
                                                   Visibility="{Binding IsWatched, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding WatchedStatusText}" 
                                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Fix Match Overlay Modal (Unconstrained, Top-level Layer) ────────── -->
        <Grid Background="#B3000000" 
              Panel.ZIndex="1000"
              MouseDown="Backdrop_MouseDown"
              Visibility="{Binding IsFixMatchOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource CouchmarkCardBrush}" 
                    BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Padding="28" 
                    Width="480"
                    MouseDown="Modal_MouseDown"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Margin="0,90,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="45" Direction="270" ShadowDepth="12" Opacity="0.8" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,36,0">
                            <ui:SymbolIcon Symbol="Search24" 
                                            Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" 
                                            FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title, StringFormat={}Fix Match — {0}}" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                       FontSize="20" FontWeight="Bold" 
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss24}" 
                                   Appearance="Secondary" 
                                   Padding="6" 
                                   HorizontalAlignment="Right" 
                                   Command="{Binding CloseFixMatchCommand}" />
                    </Grid>

                    <TextBlock Text="Enter the title, TMDB ID, or TMDB URL to re-fetch official metadata, poster, and backdrop details:"
                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                               TextWrapping="Wrap" FontSize="13" Margin="0,0,0,16" />
                    
                    <TextBox Text="{Binding FixMatchInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Padding="12,8"
                             FontSize="14"
                             Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                             Background="{DynamicResource CouchmarkBackgroundBrush}"
                             BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                             BorderThickness="1"
                             Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Command="{Binding CloseFixMatchCommand}" Margin="0,0,12,0" />
                        <ui:Button Content="Fetch Metadata" Appearance="Primary" Command="{Binding ApplyFixMatchCommand}"
                                   IsEnabled="{Binding IsFixMatching, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Intro & Outro Timestamps Overlay Modal ────────────────────────────── -->
        <Grid Background="#B3000000" 
              Panel.ZIndex="1000"
              MouseDown="TimestampsBackdrop_MouseDown"
              Visibility="{Binding IsTimestampsModalOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource CouchmarkCardBrush}" 
                    BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    Padding="28" 
                    Width="520"
                    MouseDown="Modal_MouseDown"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Margin="0,70,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="45" Direction="270" ShadowDepth="12" Opacity="0.8" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,36,0">
                            <ui:SymbolIcon Symbol="Timer24" 
                                           Foreground="#60A5FA" 
                                           FontSize="22" Margin="0,0,8,0" />
                            <TextBlock Text="Skip Timestamps" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                       FontSize="20" FontWeight="Bold" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss24}" 
                                   Appearance="Secondary" 
                                   Padding="6" 
                                   HorizontalAlignment="Right" 
                                   Command="{Binding CloseTimestampsModalCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding TimestampTargetTitle}" 
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Section 1: Intro Window -->
                    <Border Background="{DynamicResource CouchmarkBackgroundBrush}"
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="FastForward24" Foreground="#60A5FA" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Intro Window (Skip Intro button)" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" 
                                           FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Intro Start (e.g. 01:20)" 
                                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" 
                                               FontSize="12" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding IntroStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="10,6" FontSize="13"
                                             Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                             Background="{DynamicResource CouchmarkCardBrush}"
                                             BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Intro End (e.g. 02:15)" 
                                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" 
                                               FontSize="12" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding IntroEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="10,6" FontSize="13"
                                             Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                             Background="{DynamicResource CouchmarkCardBrush}"
                                             BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Outro / Credits Window -->
                    <Border Background="{DynamicResource CouchmarkBackgroundBrush}"
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Next24" Foreground="#A78BFA" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Credits Window (Skip Credits button)" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" 
                                           FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Credits Start (e.g. 42:00)" 
                                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" 
                                               FontSize="12" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding OutroStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="10,6" FontSize="13"
                                             Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                             Background="{DynamicResource CouchmarkCardBrush}"
                                             BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Credits End (e.g. 44:30)" 
                                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" 
                                               FontSize="12" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding OutroEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="10,6" FontSize="13"
                                             Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                             Background="{DynamicResource CouchmarkCardBrush}"
                                             BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Apply to Season Checkbox (TV shows only) -->
                    <CheckBox Content="Apply these timestamps to all episodes in this season" 
                              IsChecked="{Binding ApplyToEntireSeason, Mode=TwoWay}"
                              Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                              Visibility="{Binding CanApplyToSeason, Converter={StaticResource BoolToVisibilityConverter}}"
                              Margin="4,0,0,18" />

                    <!-- Buttons -->
                    <Grid>
                        <ui:Button Content="Clear Markers" 
                                   Appearance="Secondary" 
                                   Command="{Binding ClearTimestampsCommand}" 
                                   HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Cancel" Command="{Binding CloseTimestampsModalCommand}" Margin="0,0,10,0" />
                            <ui:Button Content="Save Timestamps" Appearance="Primary" 
                                       Command="{Binding SaveTimestampsCommand}"
                                       IsEnabled="{Binding IsSavingTimestamps, Converter={StaticResource InverseBoolConverter}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

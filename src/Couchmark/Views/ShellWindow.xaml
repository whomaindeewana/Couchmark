<ui:FluentWindow x:Class="Couchmark.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Couchmark.Views"
                 Title="Couchmark"
                 Icon="/Assets/Icons/Couchmark.ico"
                 Width="1280"
                 Height="800"
                 MinWidth="900"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource CouchmarkBackgroundBrush}">

    <Grid Background="{DynamicResource CouchmarkBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Title bar row (extends into window chrome) -->
            <RowDefinition Height="Auto" />
            <!-- Main content area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Custom Title Bar ──────────────────────────────────────────── -->
        <ui:TitleBar Grid.Row="0"
                     Title="Couchmark"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Icons/Couchmark.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ── Navigation View ───────────────────────────────────────────── -->
        <!--
            WPF-UI NavigationView provides the collapsible left rail with icons.
            Pages are resolved from the DI container via IPageService (set in code-behind).
        -->
        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="200"
                           IsPaneOpen="False"
                           Loaded="RootNavigation_Loaded">

            <!-- Sidebar navigation items -->
            <ui:NavigationView.MenuItems>

                <ui:NavigationViewItem Content="Home"
                                       TargetPageType="{x:Type views:HomeView}"
                                       Icon="{ui:SymbolIcon Symbol=Home24}" />

                <ui:NavigationViewItem Content="Movies"
                                       TargetPageType="{x:Type views:MoviesView}"
                                       Icon="{ui:SymbolIcon Symbol=Filmstrip24}" />

                <ui:NavigationViewItem Content="TV Shows"
                                       TargetPageType="{x:Type views:LibraryView}"
                                       Icon="{ui:SymbolIcon Symbol=Tv24}" />

            </ui:NavigationView.MenuItems>

            <!-- Settings at the bottom of the sidebar -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings"
                                       TargetPageType="{x:Type views:SettingsView}"
                                       Icon="{ui:SymbolIcon Symbol=Settings24}" />
            </ui:NavigationView.FooterMenuItems>

            <!-- Snackbar overlay for toast notifications -->
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>

        </ui:NavigationView>
    </Grid>

</ui:FluentWindow>

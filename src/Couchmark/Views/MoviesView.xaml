<Page x:Class="Couchmark.Views.MoviesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:extensions="clr-namespace:Couchmark.Extensions">
    <!--
        MoviesView: Movies library grid with live search, sorting,
        and right-click context menu actions.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  extensions:ScrollViewerExtensions.EnableMouseWheelScroll="True">
        <Grid Margin="28,24,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Top Toolbar: Title, Search & Sort ───────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Movies" 
                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                           FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />

                <!-- Live Search Box -->
                <ui:TextBox Grid.Column="1"
                            PlaceholderText="Search movies by title or genre..."
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            MaxWidth="360" Height="36"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            FontSize="14" />

                <!-- Sort Label -->
                <TextBlock Grid.Column="2" Text="Sort:" 
                           Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,8,0" />

                <!-- Sort Options ComboBox -->
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding AvailableSortOptions}"
                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                          Width="180" Height="36"
                          VerticalAlignment="Center" />
            </Grid>

            <!-- ── Empty Library Onboarding State ───────────────────────────────── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CouchmarkCardBrush}"
                    BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,48,0,0"
                    Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Filmstrip24"
                                   FontSize="48"
                                   Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                   Margin="0,0,0,16" />
                    <TextBlock Text="No movies in your library yet"
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                               FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Add your Movies folder in Settings and click Scan Now to automatically import posters, ratings, and metadata."
                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                               FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               LineHeight="20" Margin="0,0,0,24" />
                    <ui:Button Content="Add Folders &amp; Scan"
                               Icon="{ui:SymbolIcon Symbol=Settings24}"
                               Appearance="Primary"
                               Command="{Binding NavigateToSettingsCommand}"
                               Padding="20,10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Empty Search Results State ───────────────────────────────────── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CouchmarkCardBrush}"
                    BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="36"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,48,0,0"
                    Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Search24"
                                   FontSize="40"
                                   Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                   Margin="0,0,0,14" />
                    <TextBlock Text="No movies match your search"
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Try adjusting your search keywords or clear the filter."
                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,20" />
                    <ui:Button Content="Clear Search"
                               Appearance="Secondary"
                               Command="{Binding ClearSearchCommand}"
                               Padding="16,8"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Movies Poster Cards Grid ────────────────────────────────────── -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Movies}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction Margin="0,0,18,18" Padding="0" Width="200" Height="300" Cursor="Hand"
                                       IsChevronVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                       Command="{Binding DataContext.NavigateToDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding Id}"
                                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                            <!-- Right-Click Context Menu -->
                            <ui:CardAction.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="View Details"
                                              Command="{Binding PlacementTarget.Tag.NavigateToDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Id}" />
                                    <MenuItem Header="Play Movie"
                                              Command="{Binding PlacementTarget.Tag.PlayMovieCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Id}" />
                                    <MenuItem Header="Toggle Watched"
                                              Command="{Binding PlacementTarget.Tag.ToggleWatchedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Open File Location"
                                              Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </ui:CardAction.ContextMenu>

                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,200,300" RadiusX="8" RadiusY="8" />
                                </Grid.Clip>
                                <Image Source="{Binding LocalPosterPath}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                <!-- Top-Right Watched Badge -->
                                <Border Background="#CC000000" CornerRadius="14" Padding="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                        Visibility="{Binding IsWatched, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Watched">
                                    <ui:SymbolIcon Symbol="Checkmark24" Foreground="#4CAF50" FontSize="15" />
                                </Border>

                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold" 
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ReleaseYear, StringFormat={}{0}}" 
                                                   Foreground="#AAAAAA" 
                                                   FontSize="12" 
                                                   Margin="0,2,0,0" />
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>

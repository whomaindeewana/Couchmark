<Page x:Class="Couchmark.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:extensions="clr-namespace:Couchmark.Extensions">

    <Page.Resources>
        <!-- Continue Watching Card Template -->
        <DataTemplate x:Key="ContinueWatchingCardTemplate">
            <ui:CardAction Margin="0,0,16,16" Padding="0" Width="200" Height="300" Cursor="Hand"
                           IsChevronVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                           Command="{Binding DataContext.CardClickedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                           CommandParameter="{Binding}"
                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                <ui:CardAction.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Resume Playback"
                                  Command="{Binding PlacementTarget.Tag.CardClickedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Toggle Watched"
                                  Command="{Binding PlacementTarget.Tag.ToggleWatchedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Open File Location"
                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </ui:CardAction.ContextMenu>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,200,300" RadiusX="8" RadiusY="8" />
                    </Grid.Clip>
                    <Image Source="{Binding PosterPath}" Stretch="UniformToFill" />
                    
                    <Border VerticalAlignment="Bottom" Background="#D8000000" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="LightGray" FontSize="12" Margin="0,4,0,8" TextTrimming="CharacterEllipsis" />
                            
                            <!-- Progress Bar -->
                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" 
                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:CardAction>
        </DataTemplate>

        <!-- Recently Added Shows Card Template -->
        <DataTemplate x:Key="RecentShowCardTemplate">
            <ui:CardAction Margin="0,0,16,16" Padding="0" Width="200" Height="300" Cursor="Hand"
                           IsChevronVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                           Command="{Binding DataContext.CardClickedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                           CommandParameter="{Binding}"
                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                <ui:CardAction.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View Details"
                                  Command="{Binding PlacementTarget.Tag.CardClickedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Toggle Watched All"
                                  Command="{Binding PlacementTarget.Tag.ToggleWatchedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Open Folder Location"
                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </ui:CardAction.ContextMenu>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,200,300" RadiusX="8" RadiusY="8" />
                    </Grid.Clip>
                    <Image Source="{Binding PosterPath}" Stretch="UniformToFill" />

                    <!-- Top-Right Watched / Unwatched Badges -->
                    <Border Background="#CC000000" CornerRadius="14" Padding="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Visibility="{Binding IsWatched, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="All episodes watched">
                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#4CAF50" FontSize="15" />
                    </Border>
                    <Border Background="#E62563EB" CornerRadius="12" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Visibility="{Binding HasUnwatched, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Unwatched episodes">
                        <TextBlock Text="{Binding UnwatchedCount}" Foreground="White" FontSize="12" FontWeight="Bold" />
                    </Border>

                    <Border VerticalAlignment="Bottom" Background="#D8000000" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="LightGray" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:CardAction>
        </DataTemplate>

        <!-- Recently Added Movies Card Template -->
        <DataTemplate x:Key="RecentMovieCardTemplate">
            <ui:CardAction Margin="0,0,16,16" Padding="0" Width="200" Height="300" Cursor="Hand"
                           IsChevronVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                           Command="{Binding DataContext.CardClickedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                           CommandParameter="{Binding}"
                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                <ui:CardAction.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View Details"
                                  Command="{Binding PlacementTarget.Tag.ViewMovieDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Play Movie"
                                  Command="{Binding PlacementTarget.Tag.PlayMovieCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Toggle Watched"
                                  Command="{Binding PlacementTarget.Tag.ToggleWatchedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Open File Location"
                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </ui:CardAction.ContextMenu>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,200,300" RadiusX="8" RadiusY="8" />
                    </Grid.Clip>
                    <Image Source="{Binding PosterPath}" Stretch="UniformToFill" />

                    <!-- Top-Right Watched Badge -->
                    <Border Background="#CC000000" CornerRadius="14" Padding="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Visibility="{Binding IsWatched, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Watched">
                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#4CAF50" FontSize="15" />
                    </Border>

                    <Border VerticalAlignment="Bottom" Background="#D8000000" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="LightGray" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,6,0,0"
                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:CardAction>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  extensions:ScrollViewerExtensions.EnableMouseWheelScroll="True">
        <StackPanel Margin="32">
            
            <!-- Hero Banner -->
            <Border Background="{DynamicResource CouchmarkCardBrush}" 
                    BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="32" Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="{Binding HeroTitle}" 
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}" 
                               FontSize="32" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding HeroSubtitle}" 
                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}" 
                               FontSize="15" />
                </StackPanel>
            </Border>

            <!-- ── Empty Library Onboarding Card ───────────────────────────── -->
            <Border Background="{DynamicResource CouchmarkCardBrush}"
                    BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,24"
                    Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="VideoClip24"
                                   FontSize="52"
                                   Foreground="#60A5FA"
                                   Margin="0,0,0,16" />
                    <TextBlock Text="Your Couchmark library is empty"
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                               FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Point Couchmark at your local Movies and TV Shows folders in Settings, then click Scan Now to fetch artwork and start watching."
                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                               FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               LineHeight="22" Margin="0,0,0,24" />
                    <ui:Button Content="Add Folders &amp; Scan"
                               Icon="{ui:SymbolIcon Symbol=Settings24}"
                               Appearance="Primary"
                               Command="{Binding NavigateToSettingsCommand}"
                               Padding="22,10"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── All Rows Hidden / Empty Fallback ────────────────────────── -->
            <Border Background="{DynamicResource CouchmarkCardBrush}"
                    BorderBrush="{DynamicResource CouchmarkCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,24"
                    Visibility="{Binding IsAllRowsEmptyOrHidden, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Grid24"
                                   FontSize="40"
                                   Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                    <TextBlock Text="Nothing to display on Home"
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="All Home screen rows are currently hidden or have no matching items. Adjust your Home Screen preferences in Settings."
                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               LineHeight="20" Margin="0,0,0,20" />
                    <ui:Button Content="Open Settings"
                               Appearance="Secondary"
                               Command="{Binding NavigateToSettingsCommand}"
                               Padding="16,8"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── ORDER 1: Continue Watching First ────────────────────────── -->
            <StackPanel Visibility="{Binding IsContinueWatchingFirst, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Continue Watching Row -->
                <StackPanel Visibility="{Binding ShowContinueWatching, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding ContinueWatchingItems.Count, Converter={StaticResource IntToVisibilityConverter}}" Margin="0,0,0,28">
                        <TextBlock Text="Continue Watching" 
                                   Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding ContinueWatchingItems}" ItemTemplate="{StaticResource ContinueWatchingCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Recently Added TV Shows Row -->
                <StackPanel Visibility="{Binding ShowRecentlyAddedShows, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding RecentlyAddedShows.Count, Converter={StaticResource IntToVisibilityConverter}}" Margin="0,0,0,28">
                        <TextBlock Text="Recently Added TV Shows" 
                                   Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding RecentlyAddedShows}" ItemTemplate="{StaticResource RecentShowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Recently Added Movies Row -->
                <StackPanel Visibility="{Binding ShowRecentlyAddedMovies, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding RecentlyAddedMovies.Count, Converter={StaticResource IntToVisibilityConverter}}">
                        <TextBlock Text="Recently Added Movies" 
                                   Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding RecentlyAddedMovies}" ItemTemplate="{StaticResource RecentMovieCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ── ORDER 2: Recently Added First ──────────────────────────── -->
            <StackPanel Visibility="{Binding IsContinueWatchingFirst, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <!-- Recently Added TV Shows Row -->
                <StackPanel Visibility="{Binding ShowRecentlyAddedShows, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding RecentlyAddedShows.Count, Converter={StaticResource IntToVisibilityConverter}}" Margin="0,0,0,28">
                        <TextBlock Text="Recently Added TV Shows" 
                                   Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding RecentlyAddedShows}" ItemTemplate="{StaticResource RecentShowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Recently Added Movies Row -->
                <StackPanel Visibility="{Binding ShowRecentlyAddedMovies, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding RecentlyAddedMovies.Count, Converter={StaticResource IntToVisibilityConverter}}" Margin="0,0,0,28">
                        <TextBlock Text="Recently Added Movies" 
                                   Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding RecentlyAddedMovies}" ItemTemplate="{StaticResource RecentMovieCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Continue Watching Row -->
                <StackPanel Visibility="{Binding ShowContinueWatching, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding ContinueWatchingItems.Count, Converter={StaticResource IntToVisibilityConverter}}">
                        <TextBlock Text="Continue Watching" 
                                   Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding ContinueWatchingItems}" ItemTemplate="{StaticResource ContinueWatchingCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

<Page x:Class="Couchmark.Views.PlayerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
      Background="Black">
    
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <!-- ── LibVLC Video Surface ────────────────────────────────────────── -->
        <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" />

        <!-- ── Player Overlay Controls ─────────────────────────────────────── -->
        <Border Background="#E6101014" 
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                VerticalAlignment="Bottom" 
                Margin="32,0,32,28" 
                Padding="20,14"
                Visibility="{Binding ControlsVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="8" Opacity="0.6" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Seekbar & Timestamps -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Action Controls -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Seekbar Row ──────────────────────────────────────────── -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="ProgressSlider"
                            Grid.Column="0"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds, TargetNullValue=100}"
                            Value="{Binding PositionSeconds, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Height="24"
                            Margin="0,0,16,0" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding TimeDisplayText}"
                               Foreground="#CCCCCC"
                               FontSize="13"
                               FontFamily="Consolas, Segoe UI Variable"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- ── Buttons & Features Row ────────────────────────────────── -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Left Controls: Play/Pause, Next, Stop, Volume, Title -->
                        <ColumnDefinition Width="*" />
                        <!-- Right Controls: Audio, Subtitles, Fullscreen -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Playback & Volume -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Play/Pause -->
                        <ui:Button Command="{Binding PlayPauseCommand}" 
                                   Icon="{ui:SymbolIcon Symbol=Play24}" 
                                   Appearance="Primary" 
                                   ToolTip="Play / Pause (Space)"
                                   Padding="14,8"
                                   Margin="0,0,8,0" />

                        <!-- Next Episode -->
                        <ui:Button Command="{Binding PlayNextEpisodeCommand}" 
                                   Icon="{ui:SymbolIcon Symbol=Next24}" 
                                   Appearance="Secondary" 
                                   ToolTip="Next Episode"
                                   Visibility="{Binding IsEpisode, Converter={StaticResource BoolToVis}}"
                                   Padding="12,8"
                                   Margin="0,0,8,0" />

                        <!-- Stop / Exit -->
                        <ui:Button Command="{Binding StopCommand}" 
                                   Icon="{ui:SymbolIcon Symbol=Stop24}" 
                                   Appearance="Danger" 
                                   ToolTip="Stop Playback (Esc)"
                                   Padding="12,8"
                                   Margin="0,0,16,0" />

                        <!-- Volume Mute Button -->
                        <ui:Button Command="{Binding ToggleMuteCommand}" 
                                   Icon="{ui:SymbolIcon Symbol=Speaker224}" 
                                   Appearance="Transparent"
                                   ToolTip="Mute / Unmute (M)"
                                   Padding="8,8" />

                        <!-- Volume Slider -->
                        <Slider Minimum="0" Maximum="100" 
                                Value="{Binding Volume, Mode=TwoWay}" 
                                Width="85" 
                                VerticalAlignment="Center"
                                ToolTip="{Binding Volume, StringFormat='Volume: {0}%'}"
                                Margin="4,0,16,0" />

                        <!-- Current Title -->
                        <TextBlock Text="{Binding Title}" 
                                   Foreground="White" 
                                   FontSize="15" 
                                   FontWeight="SemiBold" 
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="360"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Audio, Subtitles & Fullscreen -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Audio Track Selector -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Headphones24" Foreground="#AAAAAA" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AudioTracks}"
                                      SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      ToolTip="Audio Track"
                                      Width="130"
                                      Height="32"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Subtitle Track Selector -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ClosedCaption24" Foreground="#AAAAAA" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding SubtitleTracks}"
                                      SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      ToolTip="Subtitle Track"
                                      Width="130"
                                      Height="32"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Edit Skip Markers / Timestamps -->
                        <ui:Button Command="{Binding OpenTimestampsDialogCommand}" 
                                   Icon="{ui:SymbolIcon Symbol=Timer24}" 
                                   Appearance="Secondary" 
                                   ToolTip="Edit Skip Timestamps (T)"
                                   Padding="12,8"
                                   Margin="0,0,12,0" />

                        <!-- Fullscreen -->
                        <ui:Button Command="{Binding ToggleFullscreenCommand}" 
                                   Icon="{ui:SymbolIcon Symbol=FullScreen24}" 
                                   Appearance="Secondary" 
                                   ToolTip="Toggle Fullscreen (F)"
                                   Padding="12,8" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Skip Intro / Skip Outro Floating Buttons ───────────────────── -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,48,125"
                    Panel.ZIndex="500">
            <!-- Skip Intro Button -->
            <ui:Button Content="Skip Intro"
                       Command="{Binding SkipIntroCommand}"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=FastForward24}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       ToolTip="Skip Intro (S)"
                       Padding="18,10"
                       Margin="0,0,12,0"
                       Visibility="{Binding IsSkipIntroVisible, Converter={StaticResource BoolToVis}}">
                <ui:Button.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </ui:Button.Effect>
            </ui:Button>

            <!-- Skip Outro / Credits Button -->
            <ui:Button Content="Skip Credits"
                       Command="{Binding SkipOutroCommand}"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon Symbol=Next24}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       ToolTip="Skip Credits (S)"
                       Padding="18,10"
                       Visibility="{Binding IsSkipOutroVisible, Converter={StaticResource BoolToVis}}">
                <ui:Button.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </ui:Button.Effect>
            </ui:Button>
        </StackPanel>

        <!-- ── 10-Second Next Episode Auto-Play Countdown Overlay ─────────── -->
        <Grid Background="#B3000000" 
              Panel.ZIndex="1000"
              Visibility="{Binding IsAutoPlayCountdownActive, Converter={StaticResource BoolToVis}}">
            <Border Background="#1C1C22" 
                    BorderBrush="#33FFFFFF" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    Padding="28" 
                    Width="460" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Direction="270" ShadowDepth="10" Opacity="0.8" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Next24" Foreground="#60A5FA" FontSize="20" Margin="0,0,8,0" />
                        <TextBlock Text="Up Next" FontSize="14" Foreground="#60A5FA" FontWeight="Bold" />
                    </StackPanel>

                    <TextBlock Text="{Binding NextEpisodeTitle}" 
                               FontSize="18" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,12" />

                    <TextBlock Text="{Binding AutoPlayCountdownSeconds, StringFormat='Playing next episode in {0} seconds...'}" 
                               FontSize="13" 
                               Foreground="#AAAAAA" 
                               Margin="0,0,0,24" />

                    <ProgressBar Minimum="0" Maximum="10" 
                                 Value="{Binding AutoPlayCountdownSeconds}" 
                                 Height="4" 
                                 Foreground="#60A5FA"
                                 Background="#33FFFFFF"
                                 BorderThickness="0"
                                 Margin="0,0,0,24" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Command="{Binding CancelAutoPlayCommand}" Margin="0,0,12,0" Padding="16,8" />
                        <ui:Button Content="Play Now" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play24}" Command="{Binding PlayNowAutoPlayCommand}" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Live Timestamps Overlay Dialog ────────────────────────────────────── -->
        <Grid Background="#B3000000" 
              Panel.ZIndex="1200"
              Visibility="{Binding IsTimestampsDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1C1C22" 
                    BorderBrush="#33FFFFFF" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    Padding="24" 
                    Width="500" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Direction="270" ShadowDepth="10" Opacity="0.8" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Timer24" Foreground="#60A5FA" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="Set Skip Markers" FontSize="18" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss24}" 
                                   Appearance="Secondary" 
                                   Padding="6" 
                                   HorizontalAlignment="Right" 
                                   Command="{Binding CloseTimestampsDialogCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding Title}" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,16" TextTrimming="CharacterEllipsis" />

                    <!-- Intro Section -->
                    <Border Background="#121216" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="FastForward24" Foreground="#60A5FA" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Intro Window" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>

                            <!-- Intro Start -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Intro Start:" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding EditIntroStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="32" Padding="8,4" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="2" Content="Current Time" Command="{Binding GrabCurrentForIntroStartCommand}" Padding="10,4" FontSize="12" />
                            </Grid>

                            <!-- Intro End -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Intro End:" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding EditIntroEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="32" Padding="8,4" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="2" Content="Current Time" Command="{Binding GrabCurrentForIntroEndCommand}" Padding="10,4" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Credits Section -->
                    <Border Background="#121216" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Next24" Foreground="#A78BFA" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Credits / Outro Window" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>

                            <!-- Credits Start -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Credits Start:" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding EditOutroStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="32" Padding="8,4" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="2" Content="Current Time" Command="{Binding GrabCurrentForOutroStartCommand}" Padding="10,4" FontSize="12" />
                            </Grid>

                            <!-- Credits End -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Credits End:" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding EditOutroEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="32" Padding="8,4" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="2" Content="Current Time" Command="{Binding GrabCurrentForOutroEndCommand}" Padding="10,4" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Apply to Season (TV only) -->
                    <CheckBox Content="Apply these markers to all episodes in this season" 
                              IsChecked="{Binding ApplyToEntireSeason, Mode=TwoWay}"
                              Foreground="White"
                              Visibility="{Binding CanApplyToSeason, Converter={StaticResource BoolToVis}}"
                              Margin="0,0,0,18" />

                    <!-- Buttons -->
                    <Grid>
                        <ui:Button Content="Clear Markers" Appearance="Secondary" Command="{Binding ClearTimestampsFromPlayerCommand}" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Cancel" Command="{Binding CloseTimestampsDialogCommand}" Margin="0,0,10,0" Padding="14,6" />
                            <ui:Button Content="Save Markers" Appearance="Primary" Command="{Binding SaveTimestampsFromPlayerCommand}" Padding="14,6" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

<Page x:Class="Couchmark.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:extensions="clr-namespace:Couchmark.Extensions">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  extensions:ScrollViewerExtensions.EnableMouseWheelScroll="True">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Page Header & Save Action Bar ────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Settings" 
                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                               FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Configure media scrapers, storage libraries, appearance, and home screen behavior."
                               Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                               FontSize="14" Margin="0,4,0,0" />
                </StackPanel>

                <ui:Button Content="Save Settings"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Symbol=Save24}"
                           Command="{Binding SaveCommand}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="20,10"
                           FontWeight="SemiBold" />
            </Grid>

            <!-- ── Masonry Grid Layout (Two Balanced Columns) ────────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="620" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MaxWidth="620" />
                </Grid.ColumnDefinitions>

                <!-- ── Column 1 (Left Masonry Column) ────────────────────────── -->
                <StackPanel Grid.Column="0">
                    
                    <!-- 1. API Keys Card -->
                    <Border Background="{DynamicResource CouchmarkCardBrush}" 
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="Key24" 
                                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                               FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="API Keys" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                           FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="TMDB API Key / Read Token" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                       FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBlock Text="Required to fetch posters, ratings, overviews, and cast (themoviedb.org)"
                                       Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,8" />
                            <ui:PasswordBox x:Name="TmdbKeyBox"
                                          PlaceholderText="Paste your TMDB Read Access Token"
                                          Password="{Binding TmdbApiKey, Mode=TwoWay}"
                                          Height="36"
                                          Margin="0,0,0,16" />

                            <TextBlock Text="OMDB API Key" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                       FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBlock Text="Optional: used to fetch verified IMDb scores (omdbapi.com)"
                                       Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,8" />
                            <ui:PasswordBox x:Name="OmdbKeyBox"
                                          PlaceholderText="Paste your OMDB API key"
                                          Password="{Binding OmdbApiKey, Mode=TwoWay}"
                                          Height="36" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Library Folders & Scanner Card -->
                    <Border Background="{DynamicResource CouchmarkCardBrush}" 
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="Folder24" 
                                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                               FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="Library Storage" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                           FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="Movie Folders" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                       FontWeight="Medium" Margin="0,0,0,8" />
                            <ItemsControl x:Name="MoviePathsList"
                                          ItemsSource="{Binding MoviePaths}" Margin="0,0,0,8"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding}" 
                                                       Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Foreground="#E57373"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="6,2"
                                                    FontSize="12"
                                                    ToolTip="Remove this folder"
                                                    Command="{Binding DataContext.RemoveMovieFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Content="+ Add Movie Folder"
                                       Command="{Binding AddMovieFolderCommand}"
                                       Padding="12,6" Margin="0,0,0,16" />

                            <TextBlock Text="TV Show Folders" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                       FontWeight="Medium" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding TvShowPaths}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding}" 
                                                       Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Foreground="#E57373"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="6,2"
                                                    FontSize="12"
                                                    ToolTip="Remove this folder"
                                                    Command="{Binding DataContext.RemoveTvShowFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Content="+ Add TV Show Folder"
                                       Command="{Binding AddTvShowFolderCommand}"
                                       Padding="12,6" Margin="0,0,0,20" />

                            <!-- Scan Now button -->
                            <ui:Button Content="🔄  Scan Library Now"
                                       Appearance="Primary"
                                       Command="{Binding ScanNowCommand}"
                                       Padding="16,10"
                                       FontWeight="SemiBold" />

                            <!-- Progress bar shown during scanning -->
                            <ProgressBar Value="{Binding ScanProgress}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,14,0,6" />

                            <TextBlock Text="{Binding StatusMessage}" 
                                       Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Column 2 (Right Masonry Column) ───────────────────────── -->
                <StackPanel Grid.Column="2">

                    <!-- 3. Appearance & Themes Card -->
                    <Border Background="{DynamicResource CouchmarkCardBrush}" 
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="PaintBrush24" 
                                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                               FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="Appearance &amp; Palette" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                           FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="App Theme" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                       FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBlock Text="Choose from 4 custom palettes: White, Nude (gentle on eyes), Midnight (cool navy), or Vanta Black (true OLED)."
                                       Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />

                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                      Width="240"
                                      HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- 4. Home Screen Customization Card -->
                    <Border Background="{DynamicResource CouchmarkCardBrush}" 
                            BorderBrush="{DynamicResource CouchmarkCardBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="Grid24" 
                                               Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                               FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="Home Screen (Jellyfin Style)" 
                                           Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                           FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="Toggle which category rows appear on your living room dashboard:"
                                       Foreground="{DynamicResource CouchmarkTextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,14" />

                            <CheckBox Content="Show Continue Watching Row" 
                                      Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                      IsChecked="{Binding ShowContinueWatching, Mode=TwoWay}"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Show Recently Added TV Shows Row" 
                                      Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                      IsChecked="{Binding ShowRecentlyAddedShows, Mode=TwoWay}"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Show Recently Added Movies Row" 
                                      Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                      IsChecked="{Binding ShowRecentlyAddedMovies, Mode=TwoWay}"
                                      Margin="0,0,0,18" />

                            <TextBlock Text="Dashboard Row Ordering" 
                                       Foreground="{DynamicResource CouchmarkTextPrimaryBrush}"
                                       FontWeight="Medium" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableHomeRowOrders}"
                                      SelectedItem="{Binding SelectedHomeRowOrder, Mode=TwoWay}"
                                      Width="240"
                                      HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
